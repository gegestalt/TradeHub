# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev/MVP)
DATABASE_URL=sqlite+aiosqlite:///./tradehub.db
# PostgreSQL (prod) — uncomment and fill in when ready
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tradehub

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Data Adapters ─────────────────────────────────────────────────────────────
# Path to the directory containing offline OHLCV CSV/JSON files
DATA_DIR=../data

# How often (seconds) to snapshot prices for active competitions
PRICE_SNAPSHOT_INTERVAL_SECONDS=60

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max order submissions per player per minute
ORDER_RATE_LIMIT=10
